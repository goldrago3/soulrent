---
interface Props {
  as?: 'p' | 'span' | 'div' | 'h2';
  /** `invert` per fondi scuri: `stone` su `ink` non arriva ad AA (§10). */
  tone?: 'default' | 'invert';
  class?: string | undefined;
}

// Unico punto del sito in cui il maiuscoletto è ammesso (§6).
const { as: Tag = 'p', tone = 'default', class: className }: Props = Astro.props;

const tones = {
  default: 'text-stone-strong',
  invert: 'text-stone-soft',
} as const;

const classes = ['text-eyebrow font-medium uppercase', tones[tone], className]
  .filter(Boolean)
  .join(' ');
---

<Tag class={classes}>
  <slot />
</Tag>
