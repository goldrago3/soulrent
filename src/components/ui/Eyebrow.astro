---
interface Props {
  as?: 'p' | 'span' | 'div' | 'h2';
  class?: string | undefined;
}

// Unico punto del sito in cui il maiuscoletto è ammesso (§6).
// Il colore viene da `--color-muted`, che ogni superficie ridefinisce sul
// proprio fondo: non serve dire al componente dove si trova.
const { as: Tag = 'p', class: className }: Props = Astro.props;

const classes = ['text-eyebrow font-medium uppercase text-muted', className].filter(Boolean).join(' ');
---

<Tag class={classes}>
  <slot />
</Tag>
