---
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'a'>, 'type'> {
  variant?: 'primary' | 'secondary';
  /** Se presente rende un <a>, altrimenti un <button>. */
  href?: string | undefined;
  type?: 'button' | 'submit' | 'reset';
}

const { variant = 'primary', href, type = 'button', class: className, ...rest } = Astro.props;

const base =
  'inline-flex items-center justify-center rounded-sm border px-6 py-3 text-small font-medium ' +
  // L'outline resta fuori dalla transizione: il focus deve comparire subito.
  'transition-[background-color,border-color,color] duration-400 ease-editorial';

// L'ottone tocca solo il bordo del pulsante primario (§5).
const styles = {
  primary: 'border-brass bg-ink text-bone hover:bg-sea',
  secondary: 'border-line bg-transparent text-ink hover:border-ink',
} as const;

const classes = [base, styles[variant], className].filter(Boolean).join(' ');
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} {...rest}>
      <slot />
    </button>
  )
}
