---
import Eyebrow from '../ui/Eyebrow.astro';
import LangSwitcher from './LangSwitcher.astro';
import Logo from './Logo.astro';
import { getPath, type Lang, type RouteKey } from '../../i18n/routes';
import { useTranslations, type UiKey } from '../../i18n/ui';
import { footerCompany, footerExplore } from '../../lib/navigation';
import { business } from '../../lib/site';

interface Props {
  lang: Lang;
  route: RouteKey;
}

const { lang, route } = Astro.props;
const t = useTranslations(lang);

const year = new Date().getFullYear();

const columns = [
  { heading: t('footer.explore'), items: footerExplore },
  { heading: t('footer.company'), items: footerCompany },
] as const;

// Ora che le pagine esistono, i link legali si possono mostrare.
const legali = [
  { route: 'privacy', label: 'footer.privacy' },
  { route: 'cookies', label: 'footer.cookies' },
  { route: 'terms', label: 'footer.terms' },
] as const satisfies readonly { route: RouteKey; label: UiKey }[];
---

<footer class="surface-dark">
  <div class="wrap section-y grid gap-12 md:grid-cols-2 lg:grid-cols-4">
    <div class="flex flex-col gap-4">
      <Logo variante="vertical" tone="invert" altezza={104} />
      <p class="text-small text-muted">{t('footer.positioning')}</p>
    </div>

    {
      columns.map((column) => (
        <nav aria-label={column.heading} class="flex flex-col gap-4">
          <Eyebrow as="p">{column.heading}</Eyebrow>
          <ul class="flex flex-col gap-3">
            {column.items.map((item) => (
              <li>
                <a
                  href={getPath(item.route, lang)}
                  aria-current={route === item.route ? 'page' : undefined}
                  class="text-small text-muted transition-[color] duration-400 ease-editorial hover:text-bone"
                >
                  {t(item.label)}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }

    <div class="flex flex-col gap-4">
      <Eyebrow as="p">{t('footer.contact')}</Eyebrow>
      <ul class="flex flex-col gap-3 text-small text-muted">
        <li>{business.email}</li>
        <li>{business.telephone}</li>
        <li>
          {t('footer.base')}: {business.address.locality}, {business.address.region}
        </li>
      </ul>
      <LangSwitcher lang={lang} route={route} tone="invert" class="mt-2 md:hidden" />
    </div>
  </div>

  <div class="wrap border-t border-line-invert py-8">
    <div class="flex flex-col gap-2 text-small text-muted md:flex-row md:items-center md:justify-between">
      <p>© {year} {business.name} — {t('footer.rights')}</p>
      <p>{t('footer.vat')} {business.vatId}</p>
    </div>
    <nav aria-label={t('footer.legal')} class="mt-6">
      <ul class="flex flex-wrap gap-x-8 gap-y-2 text-small text-muted">
        {
          legali.map((voce) => (
            <li>
              <a
                href={getPath(voce.route, lang)}
                aria-current={route === voce.route ? 'page' : undefined}
                class="transition-[color] duration-400 ease-editorial hover:text-bone"
              >
                {t(voce.label)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
