---
import Eyebrow from '../ui/Eyebrow.astro';
import type { Lang } from '../../i18n/routes';
import { useTranslations, type UiKey } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Quattro punti, solo tipografia: nessuna icona stock (§12).
const points = [
  { title: 'service.delivery.title', text: 'service.delivery.text' },
  { title: 'service.fleet.title', text: 'service.fleet.text' },
  { title: 'service.contact.title', text: 'service.contact.text' },
  { title: 'service.support.title', text: 'service.support.text' },
] as const satisfies readonly { title: UiKey; text: UiKey }[];
---

<section class="wrap section-y">
  <Eyebrow>{t('service.eyebrow')}</Eyebrow>
  <h2 class="mt-6 max-w-text text-h2">{t('service.title')}</h2>

  <ol class="mt-16 grid gap-10 md:grid-cols-2 md:gap-x-8 lg:grid-cols-4">
    {
      points.map((point, index) => (
        <li class="border-t border-line pt-6">
          <Eyebrow as="span">{String(index + 1).padStart(2, '0')}</Eyebrow>
          <h3 class="mt-5 text-h3">{t(point.title)}</h3>
          <p class="mt-3 text-body text-muted">{t(point.text)}</p>
        </li>
      ))
    }
  </ol>
</section>
