---
import Eyebrow from '../ui/Eyebrow.astro';
import ItineraryCard from '../itineraries/ItineraryCard.astro';
import { getPath, type Lang } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';
import { getItineraries } from '../../lib/itineraries';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Le anteprime escono dalla collection: aggiungere un itinerario le aggiorna
// da solo, senza toccare la home.
const anteprime = (await getItineraries()).slice(0, 3);
const href = getPath('itineraries', lang);
---

<section data-wa-context="itineraries" class="wrap section-y">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div class="max-w-text">
      <Eyebrow>{t('itineraries.eyebrow')}</Eyebrow>
      <h2 class="mt-6 text-h2">{t('itineraries.title')}</h2>
    </div>
    <a
      href={href}
      class="border-b border-line pb-1 text-small transition-[border-color] duration-400 ease-editorial hover:border-ink"
    >
      {t('itineraries.cta')}
    </a>
  </div>

  {
    anteprime.length === 0 ? (
      <p class="surface-shade mt-12 max-w-text px-6 py-8 text-body">{t('itineraries.empty')}</p>
    ) : (
      <ul class="mt-16 grid gap-12 md:grid-cols-3 md:gap-8">
        {anteprime.map((itinerario) => (
          <li>
            <ItineraryCard itinerario={itinerario} lang={lang} />
          </li>
        ))}
      </ul>
    )
  }
</section>
