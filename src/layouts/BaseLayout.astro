---
import '../styles/global.css';

// Font self-hosted, mai dal CDN di Google (§6): il sottoinsieme latino copre
// italiano, inglese e tedesco. Un solo peso oltre al regular.
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';

import instrumentSerif400 from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import inter400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import inter500 from '@fontsource/inter/files/inter-latin-500-normal.woff2?url';

import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppButton from '../components/layout/WhatsAppButton.astro';
import {
  defaultLang,
  getAlternates,
  getPath,
  htmlLang,
  ogLocale,
  type Lang,
  type RouteKey,
} from '../i18n/routes';
import { useTranslations } from '../i18n/ui';
import { business } from '../lib/site';
import type { WhatsAppContext } from '../lib/whatsapp';

interface Props {
  lang: Lang;
  route: RouteKey;
  title: string;
  description: string;
  /** Percorso dell'immagine Open Graph. Finché non esiste resta il segnaposto di site.ts. */
  ogImage?: string;
  ogImageAlt?: string;
  /** Messaggio di partenza del bottone WhatsApp. Nella home lo scavalca la sezione visibile. */
  whatsapp?: WhatsAppContext;
}

const { lang, route, title, description, ogImage, ogImageAlt, whatsapp = 'default' } = Astro.props;
const t = useTranslations(lang);

// Astro.site è definito in astro.config.mjs; il fallback serve solo in dev.
const origin = Astro.site ?? new URL(Astro.url.origin);
const absolute = (path: string): string => new URL(path, origin).href;

const canonical = absolute(getPath(route, lang));
const alternates = getAlternates(route);
const xDefault = absolute(getPath(route, defaultLang));

const siteName = t('site.name');
const fullTitle = title.includes(siteName) ? title : `${title} · ${siteName}`;

const socialImage = ogImage ?? business.ogImage;
const socialImageAlt = ogImageAlt ?? t('site.ogAlt');

// Dati strutturati LocalBusiness. I valori mancanti restano [TODO]: non si
// inventano né si omettono in silenzio (§13).
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${origin.origin}/#business`,
  name: business.name,
  legalName: business.legalName,
  description,
  url: absolute(getPath('home', defaultLang)),
  image: business.ogImage,
  telephone: business.telephone,
  email: business.email,
  vatID: business.vatId,
  foundingDate: business.foundingYear,
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address.street,
    postalCode: business.address.postalCode,
    addressLocality: business.address.locality,
    addressRegion: business.address.region,
    addressCountry: business.address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: business.geo.latitude,
    longitude: business.geo.longitude,
  },
  areaServed: {
    '@type': 'Place',
    name: 'Sardegna',
  },
  availableLanguage: ['it', 'en', 'de'],
  openingHoursSpecification: '[TODO orari di apertura]',
  priceRange: '[TODO]',
  sameAs: business.sameAs,
};

// Evita che una stringa di contenuto possa chiudere il tag <script>.
const localBusinessJson = JSON.stringify(localBusiness).replace(/</g, '\\u003c');

const preloadedFonts = [instrumentSerif400, inter400, inter500];
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {
      preloadedFonts.map((href) => (
        <link rel="preload" href={href} as="font" type="font/woff2" crossorigin="anonymous" />
      ))
    }

    {/* hreflang per tutte e tre le lingue più x-default sull'italiano (§7). */}
    {
      alternates.map((alternate) => (
        <link rel="alternate" hreflang={alternate.hreflang} href={absolute(alternate.path)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {
      alternates
        .filter((alternate) => alternate.lang !== lang)
        .map((alternate) => (
          <meta property="og:locale:alternate" content={ogLocale[alternate.lang]} />
        ))
    }
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={socialImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    {/*
      Unico colore scritto fuori da global.css in tutto il progetto: un meta
      tag non può leggere una variabile CSS. Deve restare uguale a `--color-ink`.
    */}
    <meta name="theme-color" content="#0f1113" />

    <script is:inline type="application/ld+json" set:html={localBusinessJson} />
  </head>

  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only-focusable">{t('skip.toContent')}</a>
    <Header lang={lang} route={route} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} route={route} />
    <WhatsAppButton lang={lang} context={whatsapp} />
  </body>
</html>
