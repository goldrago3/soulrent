---
import type { GetStaticPaths } from 'astro';
import FleetRoute from '../../../components/fleet/FleetRoute.astro';
import { fleetStaticPaths, type FleetRouteProps } from '../../../lib/fleet';

// Indice, pagine di categoria e schede della flotta, in en.
// I percorsi escono dai file in src/content/fleet: nessun elenco da aggiornare.
export const getStaticPaths = (async () => fleetStaticPaths('en')) satisfies GetStaticPaths;

type Props = FleetRouteProps;
---

<FleetRoute lang="en" {...Astro.props} />
