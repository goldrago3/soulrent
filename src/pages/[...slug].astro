---
import type { GetStaticPaths } from 'astro';
import ContentRoute from '../components/content/ContentRoute.astro';
import { languages, normalizePath, routes, type Lang } from '../i18n/routes';
import { titoli, type PaginaSingola } from '../lib/contentRoutes';

/**
 * Tutte le pagine singole del sito, nelle tre lingue: quelle costruite e
 * quelle ancora scheletro. L'elenco vive in src/lib/contentRoutes.ts.
 *
 * Home, flotta e itinerari hanno rotte proprie e non passano di qui.
 */
export const getStaticPaths = (() =>
  (Object.keys(titoli) as PaginaSingola[]).flatMap((pagina) =>
    languages.map((lang) => ({
      // `normalizePath` toglie lo slash finale, `slice(1)` quello iniziale:
      // `[...slug]` vuole il percorso senza estremi.
      params: { slug: normalizePath(routes[pagina][lang]).slice(1) },
      props: { pagina, lang },
    })),
  )) satisfies GetStaticPaths;

interface Props {
  pagina: PaginaSingola;
  lang: Lang;
}

const { pagina, lang } = Astro.props;
---

<ContentRoute pagina={pagina} lang={lang} />
